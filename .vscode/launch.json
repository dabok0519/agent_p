{
  "version": "0.2.0",
  "configurations": [
    {
      // hook 은 stdin 으로 JSON 을 받아야 돌아간다. "현재 파일" 로 F5 하면 stdin 이 없어 12줄에서 영원히 기다린다.
      // 그래서 cmd 의 echo 로 JSON 을 넣어 준다 (PowerShell 파이프는 BOM 이 붙어 JSON.parse 가 깨진다. 실측).
      // 다른 hook 을 볼 땐 아래 JSON 과 파일명만 바꾼다.
      "name": "stop-gate 디버그",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "cmd.exe",
      "runtimeArgs": ["/c", "echo {\"stop_hook_active\":false}| node hook-lab/stop-gate.mjs"],
      "cwd": "${workspaceFolder}",
      "env": { "CLAUDE_PROJECT_DIR": "${workspaceFolder}" },
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"],
      "autoAttachChildProcesses": true
    },
    {
      // F5 는 지금 편집기에 열려 있는 파일을 돌린다. 특정 파일로 고정하지 않는다.
      "name": "현재 파일",
      "type": "node",
      "request": "launch",
      "program": "${file}",
      "runtimeArgs": ["--import", "tsx"],
      // 출력이 길어 Debug Console 보다 터미널이 보기 편하다.
      "console": "integratedTerminal",
      // 중단점 없이 첫 줄부터 F10 으로 훑고 싶으면 true 로.
      "stopOnEntry": false,
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"],
      "smartStep": true,
      // main.ts 가 띄우는 MCP 서버(자식 프로세스)에도 디버거를 붙인다. 없으면 match-graph.ts 중단점이 안 걸린다.
      "autoAttachChildProcesses": true
    },
    {
      // 웹 서버를 디버거 밑에서 띄운다. handle 안에 중단점을 찍고, 다른 터미널에서 curl 을 쏘면 거기서 멈춘다.
      // 서버는 요청을 기다리는 프로그램이라 띄우기만 해선 중단점에 안 걸린다. 요청이 와야 handle 이 돈다.
      "name": "web server",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/src/web/server.ts",
      "runtimeArgs": ["--import", "tsx"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopOnEntry": false,
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"],
      "smartStep": true
    },
    {
      // 선언만 있는 파일을 열어 둔 채로도 도구 왕복을 돌리고 싶을 때 고른다.
      "name": "main",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/src/fetch/main.ts",
      "runtimeArgs": ["--import", "tsx"],
      "console": "integratedTerminal",
      "stopOnEntry": false,
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"],
      "smartStep": true
    },
    {
      // 시험 파일로 고정. 어느 파일을 보고 있든 이걸 고르면 시험이 돈다.
      // --test 를 안 붙인다. 붙이면 자식 프로세스에서 돌아 디버거가 못 붙는다.
      // node 는 시험 파일을 직접 돌려도 안의 시험을 실행한다.
      "name": "tools.test",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/src/fetch/tools.test.ts",
      "runtimeArgs": ["--import", "tsx"],
      "console": "integratedTerminal",
      "stopOnEntry": false,
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"],
      "smartStep": true
    }
  ]
}
