{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "agent",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/src/cli.ts",
      "runtimeArgs": ["--import", "tsx"],
      // 질문을 표준입력으로 받으므로 integratedTerminal 이어야 입력이 된다.
      // Debug Console 에서는 입력을 못 받아 그대로 멈춘다.
      "console": "integratedTerminal",
      // 중단점 없이 첫 줄부터 F10 으로 훑고 싶으면 true 로.
      "stopOnEntry": false,
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"],
      // zod 가 new Function 으로 만든 검증 코드(VM…)는 경로가 없어 skipFiles 에 안 걸린다.
      // 소스맵으로 원본에 매핑 안 되는 코드는 건너뛰게 한다.
      "smartStep": true
    }
  ]
}
